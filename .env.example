# ==========================================
# CivicFix — MERN Stack Environment Config
# ==========================================

# Server Port (default 5000)
PORT=5000

# MongoDB Connection String:
# - Leave blank or omit to automatically launch zero-configuration in-memory embedded MongoDB
# - Or provide local MongoDB: mongodb://127.0.0.1:27017/civicfix
# - Or provide MongoDB Atlas cloud URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/civicfix
MONGODB_URI=

# JWT Secret Key for authenticating Citizens, Officers, and Admins
JWT_SECRET=civicfix_jwt_super_secret_key_evaluation_2026

# Secret key required for automated cron endpoint /api/cron/escalate
CRON_SECRET=civicfix-cron-secret-demo-key

# SLA Time Unit:
# - 'hours' (standard production behavior)
# - 'minutes' (demo/evaluation mode for rapid automated SLA breaches in live presentations)
SLA_TIME_UNIT=hours

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-only for admin cron & system actions, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job Protection Secret for /api/cron/escalate
CRON_SECRET=your-secret-cron-token-here

# Base URL for public site (e.g. for absolute links in notifications / emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SLA Time Unit: 'hours' (production default) or 'minutes' (demo mode for instant escalations)
SLA_TIME_UNIT=hours
